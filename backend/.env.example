NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Supabase Postgres
# Copia de Supabase Dashboard > Project Settings > Database > Connection string.
# Para desenvolvimento online, usa a connection string direta ou pooler indicada pelo Supabase.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@SUPABASE_DB_HOST:6543/postgres?schema=public

# Redis online (ex.: Upstash/Redis Cloud). Para Docker local: redis://localhost:6379
REDIS_URL=rediss://default:REDIS_PASSWORD@REDIS_HOST:6379

JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Supabase Storage S3
# Ativa Storage > Settings > S3 protocol e gera Access Key ID/Secret no Supabase.
S3_REGION=eu-west-3
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_BUCKET=economia-historia
S3_ACCESS_KEY_ID=SUPABASE_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=SUPABASE_S3_SECRET_ACCESS_KEY
S3_PUBLIC_BASE_URL=https://PROJECT_REF.supabase.co/storage/v1/object/public/economia-historia

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
