NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/economia_historia?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-with-64-random-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-with-64-random-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=economia-historia
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/economia-historia

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
