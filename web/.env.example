# URL base da API. Em desenvolvimento usa o proxy do Vite (ver vite.config.ts).
VITE_API_URL=/api/v1

# Base URL pública do Supabase Storage (igual a S3_PUBLIC_BASE_URL no backend).
# Usada para construir a URL pública de um ficheiro carregado a partir da sua "key".
VITE_PUBLIC_ASSET_URL=https://<projeto>.supabase.co/storage/v1/object/public/<bucket>
